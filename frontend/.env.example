# Configuration du conteneur frontend.
# Appliquée au démarrage : aucune reconstruction d'image n'est nécessaire.

# Adresse du service de signature vue depuis le navigateur.
# « /api » utilise le proxy Nginx interne (recommandé).
API_BASE_URL=/api

# --- Keycloak ---
# Laisser vide pour démarrer sans authentification (installation initiale).
# Le client doit être PUBLIC : un SPA ne peut protéger aucun secret.
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=esign-frontend
KEYCLOAK_SCOPE=openid profile email

# --- Personnalisation ---
BRANDING_COMPANY_NAME=360DigitalTrust
BRANDING_PRODUCT_NAME=Signature électronique
BRANDING_LOGO_URL=
BRANDING_ACCENT_RGB=27 95 168
BRANDING_SUPPORT_EMAIL=
BRANDING_LEGAL_URL=

DEFAULT_LOCALE=fr
