# =============================================================
# 360DigitalTrust — Configuration de l'environnement
# Copier ce fichier en .env et adapter les valeurs
# =============================================================

# --- Général ---
COMPOSE_PROJECT_NAME=360digitaltrust
DOMAIN=localhost
ENV=development

# --- EJBCA ---
EJBCA_IMAGE=keyfactor/ejbca-ce:latest
EJBCA_ADMIN_PASSWORD=changeme_admin_2026!
EJBCA_DB_HOST=pki-db
EJBCA_DB_PORT=5432
EJBCA_DB_NAME=ejbca
EJBCA_DB_USER=ejbca
EJBCA_DB_PASSWORD=changeme_db_2026!

# Noms des CA créées au premier démarrage
CA_ROOT_NAME=360DT-Root-CA
CA_SUB_SIGN_NAME=360DT-Sub-Signature-CA
CA_SUB_TSA_NAME=360DT-Sub-TSA-CA
CA_SUB_OCSP_NAME=360DT-Sub-OCSP-CA

# Token EJBCA : SOFT = SoftHSM2, PKCS11 = HSM matériel
CA_TOKEN_TYPE=SOFT
CA_TOKEN_PIN=changeme_hsm_2026!

# --- PostgreSQL (EJBCA) ---
POSTGRES_DB=ejbca
POSTGRES_USER=ejbca
POSTGRES_PASSWORD=changeme_db_2026!

# --- Redis ---
REDIS_PASSWORD=changeme_redis_2026!
REDIS_CACHE_TTL_OCSP=86400
REDIS_CACHE_TTL_CRL=3600

# --- Signature API ---
SIG_API_PORT=8080
SIG_API_SECRET_KEY=changeme_sig_secret_2026!
EJBCA_REST_API_URL=https://pki-ca:8443/ejbca/ejbca-rest-api/v1

# --- Vault ---
VAULT_DEV_ROOT_TOKEN_ID=root-dev-token-2026
VAULT_ADDR=http://vault:8210

# --- Frontend ---
FRONTEND_PORT=3001

# Adresse du service de signature vue depuis le navigateur.
# « /api » passe par le proxy Nginx interne (recommandé).
API_BASE_URL=/api

# Keycloak — laisser vide pour démarrer sans authentification.
# Le client doit être PUBLIC (Authorization Code + PKCE, aucun secret).
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=esign-frontend

# Personnalisation client (appliquée au démarrage, sans rebuild d'image)
BRANDING_COMPANY_NAME=360DigitalTrust
BRANDING_PRODUCT_NAME=Signature électronique
BRANDING_LOGO_URL=
BRANDING_ACCENT_RGB=27 95 168
BRANDING_SUPPORT_EMAIL=
BRANDING_LEGAL_URL=
DEFAULT_LOCALE=fr

# --- Traefik ---
TRAEFIK_DASHBOARD_PORT=8888

# --- Monitoring ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_grafana_2026!
PROMETHEUS_RETENTION=15d
