# =============================================================
# 360DigitalTrust — Variables d'environnement
# Copier en .env et adapter AVANT le premier docker compose up
# =============================================================

COMPOSE_PROJECT_NAME=360digitaltrust
DOMAIN=localhost
ENV=development

# --- EJBCA ---
EJBCA_IMAGE=keyfactor/ejbca-ce:latest
EJBCA_ADMIN_PASSWORD=changeme_admin_2026!
EJBCA_DB_HOST=pki-db
EJBCA_DB_PORT=5432
EJBCA_DB_NAME=ejbca
EJBCA_DB_USER=ejbca
EJBCA_DB_PASSWORD=changeme_db_2026!

CA_TOKEN_PIN=changeme_hsm_2026!

# --- PostgreSQL ---
# Doit correspondre exactement à EJBCA_DB_USER / EJBCA_DB_PASSWORD
POSTGRES_DB=ejbca
POSTGRES_USER=ejbca
POSTGRES_PASSWORD=changeme_db_2026!

# --- Redis ---
REDIS_PASSWORD=changeme_redis_2026!

# --- Signature API ---
SIG_API_PORT=8080
SIG_API_SECRET_KEY=changeme_sig_secret_2026!
EJBCA_REST_API_URL=https://pki-ca:8443/ejbca/ejbca-rest-api/v1

# --- Vault (désactivé par défaut — lancer avec --profile vault) ---
VAULT_DEV_ROOT_TOKEN_ID=root-dev-token-2026
VAULT_ADDR=http://vault:8200

# --- Frontend ---
FRONTEND_PORT=3001

# --- Traefik ---
TRAEFIK_DASHBOARD_PORT=8888

# --- Monitoring ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_grafana_2026!
PROMETHEUS_RETENTION=15d
